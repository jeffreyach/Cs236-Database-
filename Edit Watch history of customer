def connect_db():
    dbuser = getpass.getuser()
    dbpass = getpass.getpass("Password: ")

    connStr = "host=csdept dbname=cs236proj user=%s password=%s" % (
        dbuser,
        dbpass
    )

    return connect(connStr)


def safe_input(prompt):
    val = input(prompt).strip()

    if val.lower() == "q":
        return None

    return val


def get_positive_int(prompt):
    valid = False
    number = None

    while not valid:
        
        val = safe_input(prompt)

        if val is None:
            return None

        try:
            val = int(val)

            if val > 0:
                number = val
                valid = True
            else:
                print("Enter a positive integer.")

        except:
            print("Enter a positive integer.")

    return number


def view_movies(dbcursor):
    print("\nMovie Catalog")

    dbcursor.execute(
        """
        SELECT movie_id, title, genre, release_year, duration, studio_id
        FROM group5.movies
        ORDER BY title
        """
    )

    rows = dbcursor.fetchall()

    if len(rows) == 0:
        print("No movies found.")
    else:
        print("%-5s %-25s %-15s %-10s %-10s %-10s" %
              ("ID", "Title", "Genre", "Year", "Duration", "Studio ID"))
        print("-" * 80)

        for row in rows:
            print("%-5s %-25s %-15s %-10s %-10s %-10s" %
                  (row[0], row[1], row[2], row[3], row[4], row[5]))


