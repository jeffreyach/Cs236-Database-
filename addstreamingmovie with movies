# This program adds customers or movies to the movie streaming database

import getpass
from psycopg2 import connect


# Connect to database
def connect_db():

    dbuser = getpass.getuser()
    dbpass = getpass.getpass("Password: ")

    connStr = "host=csdept dbname=cs236 user=%s password=%s" % (
        dbuser,
        dbpass
    )

    return connect(connStr)


# Safe input function
def safe_input(prompt):

    val = input(prompt).strip()

    if val.lower() == "q":
        return None

    return val


# Positive integer validation
def get_positive_int(prompt):

    valid = False
    number = None

    while not valid:

        val = safe_input(prompt)

        if val is None:
            return None

        try:

            val = int(val)

            if val > 0:
                number = val
                valid = True
            else:
                print("Enter a positive integer.")

        except:
            print("Enter a positive integer.")

    return number


# Simple email validation
def valid_email(email):

    return "@" in email and "." in email


# Simple date validation
def valid_dob(dob):

    return len(dob) == 10


# Add customer
def add_customer(cur):

    print("\n=== Add Customer ===")
    print("Type 'q' anytime to cancel.\n")

    first_name = ""

    while first_name == "":

        first_name = safe_input("First Name: ")

        if first_name is None:
            return

        if first_name == "":
            print("First name cannot be empty.")

    last_name = ""

    while last_name == "":

        last_name = safe_input("Last Name: ")

        if last_name is None:
            return

        if last_name == "":
            print("Last name cannot be empty.")

    valid = False
    email = ""

    while not valid:

        email = safe_input("Email: ")

        if email is None:
            return

        if valid_email(email):
            valid = True
        else:
            print("Enter a valid email address.")

    valid = False
    date_of_birth = ""

    while not valid:

        date_of_birth = safe_input(
            "Date of Birth (YYYY-MM-DD): "
        )

        if date_of_birth is None:
            return

        if valid_dob(date_of_birth):
            valid = True
        else:
            print("Enter date in YYYY-MM-DD format.")

    print("\n=== Available Subscriptions ===")

    cur.execute(
        """
        SELECT subscription_id, price, duration
        FROM group5.subscriptions
        ORDER BY subscription_id
        """
    )

    rows = cur.fetchall()

    for row in rows:

        print(
            "ID:", row[0],
            "| Price: $", row[1],
            "| Duration:", row[2], "days"
        )

    subscription_id = None

    while subscription_id is None:

        selected_id = get_positive_int(
            "\nChoose Subscription ID: "
        )

        if selected_id is None:
            return

        cur.execute(
            """
            SELECT subscription_id
            FROM group5.subscriptions
            WHERE subscription_id = %s
            """,
            (selected_id,)
        )

        if cur.fetchone() is not None:
            subscription_id = selected_id
        else:
            print("That subscription ID does not exist.")

    cur.execute(
        """
        INSERT INTO group5.customers
        (
            email,
            date_of_birth,
            first_name,
            last_name,
            subscription_id
        )

        VALUES (%s, %s, %s, %s, %s)

        RETURNING customer_id
        """,

        (
            email,
            date_of_birth,
            first_name,
            last_name,
            subscription_id
        )
    )

    customer_id = cur.fetchone()[0]

    print("\nCustomer added successfully.")
    print("Generated Customer ID:", customer_id)


# Add movie
def add_movie(cur):

    print("\n=== Add Movie ===")
    print("Type 'q' anytime to cancel.\n")

    title = ""

    while title == "":

        title = safe_input("Movie Title: ")

        if title is None:
            return

        if title == "":
            print("Movie title cannot be empty.")

    genre = ""

    while genre == "":

        genre = safe_input("Genre: ")

        if genre is None:
            return

        if genre == "":
            print("Genre cannot be empty.")

    release_year = None
    valid = False

    while not valid:

        year = get_positive_int("Release Year: ")

        if year is None:
            return

        if year >= 1888:
            release_year = year
            valid = True
        else:
            print("Enter a valid release year.")

    duration = None
    valid = False

    while not valid:

        movie_duration = get_positive_int(
            "Duration in Minutes: "
        )

        if movie_duration is None:
            return

        if movie_duration > 0:
            duration = movie_duration
            valid = True
        else:
            print("Enter a valid duration.")

    print("\n=== Available Studios ===")

    cur.execute(
        """
        SELECT studio_id, studio_name
        FROM group5.studio
        ORDER BY studio_id
        """
    )

    rows = cur.fetchall()

    for row in rows:

        print(
            "ID:", row[0],
            "| Studio:", row[1]
        )

    studio_id = None

    while studio_id is None:

        selected_id = get_positive_int(
            "\nChoose Studio ID: "
        )

        if selected_id is None:
            return

        cur.execute(
            """
            SELECT studio_id
            FROM group5.studio
            WHERE studio_id = %s
            """,
            (selected_id,)
        )

        if cur.fetchone() is not None:
            studio_id = selected_id
        else:
            print("That studio ID does not exist.")

    cur.execute(
        """
        INSERT INTO group5.movies
        (
            title,
            genre,
            release_year,
            duration,
            studio_id
        )

        VALUES (%s, %s, %s, %s, %s)

        RETURNING movie_id
        """,

        (
            title,
            genre,
            release_year,
            duration,
            studio_id
        )
    )

    movie_id = cur.fetchone()[0]

    print("\nMovie added successfully.")
    print("Generated Movie ID:", movie_id)


# Menu
def menu():

    print("\n=== Movie Streaming Database ===")
    print("1. Add Customer")
    print("2. Add Movie")
    print("3. Quit")


# Main function
def main():

    conn = connect_db()

    cur = conn.cursor()

    running = True

    while running:

        menu()

        choice = safe_input("\nEnter your choice: ")

        if choice is None:
            running = False

        elif choice == "1":

            add_customer(cur)

            conn.commit()

        elif choice == "2":

            add_movie(cur)

            conn.commit()

        elif choice == "3":

            running = False

        else:
            print("Invalid choice.")

    cur.close()

    conn.close()

    print("\nProgram ended.")


# Program start
if __name__ == "__main__":
    main()
