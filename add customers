def safe_input(prompt):
    val = input(prompt)
    if val.lower() == "q":
        return None
    return val


def get_positive_int(prompt):
    while True:
        val = safe_input(prompt)
        if val is None:
            return None
        try:
            val = int(val)
            if val > 0:
                return val
        except:
            pass
        print("Enter a positive integer.")


def get_float(prompt):
    while True:
        val = safe_input(prompt)
        if val is None:
            return None
        try:
            val = float(val)
            if val >= 0:
                return val
        except:
            pass
        print("Enter a valid number.")
        
